{
  "version": "0.2.0",
  "configurations": [
    {
      // Sem --dart-define o AppConfig ja usa a URL de producao (Render).
      "name": "App (producao)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart"
    },
    {
      // Celular fisico falando com o Spring local: trocar o IP quando a maquina
      // mudar de rede.
      "name": "App (local - device fisico)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://192.168.8.2:8080"]
    },
    {
      // No emulador, 10.0.2.2 aponta para a maquina que roda o Spring.
      "name": "App (local - emulador Android)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--dart-define=API_BASE_URL=http://10.0.2.2:8080"]
    },
    {
      "name": "App (local - Windows desktop)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "windows",
      "args": ["--dart-define=API_BASE_URL=http://localhost:8080"]
    }
  ]
}
